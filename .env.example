# Copy to .env (ignored by Git). Development values only: never commit real secrets.
# Use 127.0.0.1, not localhost: on Windows localhost resolves to IPv6 (::1) first and the
# compose ports are published on IPv4 only.
DATABASE_URL=postgresql+psycopg://hookgate:hookgate@127.0.0.1:5432/hookgate?connect_timeout=5
REDIS_URL=redis://127.0.0.1:6379/0
BROKER_URL=amqp://hookgate:hookgate@127.0.0.1:5672//
WEBHOOK_SECRET=dev-only-webhook-secret-change-me
ADMIN_API_KEY=dev-only-admin-key-change-me

# Optional tuning (defaults shown)
TIMESTAMP_TOLERANCE_S=300
DEDUPE_TTL_S=86400
LEASE_S=60
MAX_ATTEMPTS=5
RETRY_BASE_S=2
RETRY_CAP_S=300
REDIS_SOCKET_TIMEOUT_S=0.05
SWEEP_INTERVAL_S=15